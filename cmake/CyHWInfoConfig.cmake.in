@PACKAGE_INIT@

set(cyhwinfo_lhm_runtime "@PACKAGE_CMAKE_INSTALL_BINDIR@/cyhwinfo-lhm")

if("@cyhwinfo_uses_hwinfo@" STREQUAL "TRUE")
    include(CMakeFindDependencyMacro)
    find_dependency(lfreist-hwinfo 2 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CyHWInfoTargets.cmake")
if("UI" IN_LIST CyHWInfo_FIND_COMPONENTS AND NOT TARGET CyHWInfo::UI
   AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/CyHWInfoUITargets.cmake")
    if(NOT TARGET CyUI::Core)
        find_package(CyUI CONFIG QUIET)
    endif()
    if(TARGET CyUI::Core)
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/CyHWInfoUITargets.cmake")
        set_property(TARGET CyHWInfo::UI APPEND PROPERTY INTERFACE_LINK_LIBRARIES CyUI::Core)
    endif()
endif()
if(TARGET CyHWInfo::LibreHardwareMonitor)
    set_property(TARGET CyHWInfo::LibreHardwareMonitor PROPERTY
        CYHWINFO_SENSOR_BRIDGE_DIR "${cyhwinfo_lhm_runtime}")
    include("${CMAKE_CURRENT_LIST_DIR}/DeployLibreHardwareMonitor.cmake")
endif()
unset(cyhwinfo_lhm_runtime)
foreach(component IN LISTS CyHWInfo_FIND_COMPONENTS)
    if(TARGET CyHWInfo::${component})
        set(CyHWInfo_${component}_FOUND TRUE)
    else()
        set(CyHWInfo_${component}_FOUND FALSE)
        if(CyHWInfo_FIND_REQUIRED_${component})
            set(CyHWInfo_NOT_FOUND_MESSAGE "CyHWInfo component '${component}' was not installed")
            if(component STREQUAL "UI" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/CyHWInfoUITargets.cmake")
                set(CyHWInfo_NOT_FOUND_MESSAGE "The installed CyHWInfo UI needs the matching CyUI::Core target")
            endif()
        endif()
    endif()
endforeach()
check_required_components(CyHWInfo)
